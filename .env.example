# Storage and upload controls
ED_DATA_DIR=./data
ED_MAX_UPLOAD_MB=25
ED_CHUNK_SIZE=900
ED_CHUNK_OVERLAP=120

# Retrieval: hybrid | vector | bm25. Local Sentence Transformers + FAISS requires `pip install -e 'backend[vector]'`.
ED_RETRIEVAL_MODE=hybrid
ED_VECTOR_WEIGHT=0.55
ED_BM25_WEIGHT=0.45
ED_EMBEDDING_PROVIDER=local
ED_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ED_MIN_RELEVANCE=0.40
ED_OUTDATED_AFTER_DAYS=365

# Generation: extractive (offline, default) | openai-compatible (OpenAI API or a local compatible server such as Ollama)
ED_LLM_PROVIDER=extractive
ED_LLM_MODEL=
ED_LLM_BASE_URL=
# Never commit a real key. Keep empty for local compatible servers that do not require authentication.
ED_LLM_API_KEY=
